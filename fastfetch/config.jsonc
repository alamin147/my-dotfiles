{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/fastfetch-emblem.png",
    "width": 28,
    "height": 14,
    "padding": { "top": 5, "right": 5, "left": 3 }
  },
  "display": {
    // Editorial dossier, mirroring the website/Hub Profile: grouped sections
    // under mono eyebrow headers, one vermillion accent. Keys are fixed truecolor
    // (not palette slots) so they stay legible under any theme.
    "color": { "keys": "38;2;41;162;152" },
    "key": { "width": 9 },
    "separator": "  ",
    "percent": {
      "type": 9,
      "color": { "green": "38;2;113;185;0", "yellow": "38;2;81;182;172", "red": "38;2;219;48;45" }
    }
  },
  "modules": [
    "break",
    // { "type": "title", "format": "\u001b[1;38;2;158;171;172m{user-name}\u001b[0m\u001b[38;2;173;183;183m @ \u001b[0m\u001b[1;38;2;158;171;172m{host-name}\u001b[0m" },
    { "type": "custom", "format": "\u001b[38;2;41;162;152m\u25a0\u001b[0m \u001b[38;2;173;183;183mAl Amin \u00b7  Alfa\u001b[0m" },
    "break",

    { "type": "custom", "format": "\u001b[38;2;41;162;152m\u2500\u2500\u001b[0m \u001b[1;38;2;158;171;172mVITALS\u001b[0m \u001b[38;2;0;32;42m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m" },
    { "type": "cpu",    "key": "CPU" },
    { "type": "gpu",    "key": "GPU", "detectionMethod": "pci" },
    { "type": "memory", "key": "MEMORY" },
    { "type": "disk",   "key": "DISK" },
    "break",

    { "type": "custom", "format": "\u001b[38;2;41;162;152m\u2500\u2500\u001b[0m \u001b[1;38;2;158;171;172mSYSTEM\u001b[0m \u001b[38;2;0;32;42m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m" },
    { "type": "command", "key": "OS",     "text": "Fedora 44" },
    { "type": "command", "key": "BRANCH", "text": "ryoku version --branch 2>/dev/null || echo main" },
    { "type": "kernel",  "key": "KERNEL" },
    { "type": "command", "key": "WM",     "text": "echo \"${XDG_CURRENT_DESKTOP:-Hyprland}\"" },
    { "type": "shell",   "key": "SHELL" },
    { "type": "packages","key": "PKGS" },
    "break",

    { "type": "custom", "format": "\u001b[38;2;41;162;152m\u2500\u2500\u001b[0m \u001b[1;38;2;158;171;172mSESSION\u001b[0m \u001b[38;2;0;32;42m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m" },
    { "type": "uptime",  "key": "UPTIME" },
    { "type": "command", "key": "AGE", "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days" },
    { "type": "terminal","key": "TERM" },
    "break",

    { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
    "break"
  ]
}
